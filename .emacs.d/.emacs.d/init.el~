  (interactive)
  (setq compilation-directory-locked t)
  (message "Compilation directory is locked."))

(defun unlock-compilation-directory ()
  (interactive)
  (setq compilation-directory-locked nil)
  (message "Compilation directory is roaming."))

(defun find-project-directory ()
  "Find the project directory."
  (interactive)
  (setq find-project-from-directory default-directory)
  (if (bound-and-true-p compilation-directory-locked)
      (cd last-compilation-directory)
    (cd find-project-from-directory)
    (find-project-directory-recursive)
    (setq last-compilation-directory default-directory)))

(defun my-display-compilation-in-opposite-window (buffer &optional alist)
  "Display the compilation BUFFER in the opposite window."
  (let* ((current-window (selected-window))
         ;; Find the other window, or split if one doesn't exist
         (opposite-window (if (one-window-p)
                              (split-window-horizontally) 
                            (next-window))))
    (set-window-buffer opposite-window buffer)
    ;; Return the window where we put the buffer (standard Emacs behavior)
    opposite-window))

(defun my-display-compilation-no-select (buffer &optional alist)
  "Show compilation buffer in the 'other' window, splitting if needed, but DO NOT steal focus."
  (let* ((window (cond
                  ;; If the buffer is already showing, reuse that window
                  ((get-buffer-window buffer))
                  ;; If there is another window available, use it
                  ((window-next-sibling) (window-next-sibling))
                  ((window-prev-sibling) (window-prev-sibling))
                  ;; If we are the only window, split horizontally
                  (t (split-window-horizontally) (window-next-sibling)))))
    (set-window-buffer window buffer)
    ;; Return the window so Emacs knows we handled it
    window))

;; THIS is the safe replacement for 'display-buffer-overriding-action'
;; It tells Emacs: "Only use my custom split logic for buffers named *compilation*"
(add-to-list 'display-buffer-alist
             '("\\*compilation\\*"
               (my-display-compilation-no-select)))

